# Required: server-side Groq key. Never expose this with a PUBLIC_ prefix.
GROQ_API_KEY=
# Required: public origin used by Better Auth callbacks and trusted-origin checks.
PUBLIC_APP_URL=http://localhost:4321
# Required: Better Auth base URL. Use the same origin as PUBLIC_APP_URL locally.
BETTER_AUTH_URL=http://localhost:4321
# Required: generate with `openssl rand -base64 32`; keep server-side only.
BETTER_AUTH_SECRET=
# Required: Neon pooled runtime connection string from Neon Dashboard → Connect → Pooled connection.
DATABASE_URL=
# Required for migrations: Neon direct/unpooled connection string from Neon Dashboard → Connect → Direct connection.
DATABASE_URL_UNPOOLED=
# Optional: enable GitHub sign-in only when both values are configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: enable Google sign-in only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for outbound phone calls. Exotel Dashboard → API credentials.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Mumbai: https://api.in.exotel.com/v1; Singapore: https://api.exotel.com/v1.
EXOTEL_API_HOST=https://api.exotel.com/v1
# ExoPhone provisioned for outbound calling; do not substitute a trial number unless Exotel accepts it.
EXOTEL_CALLER_ID=
# Public WSS origin of the separately deployed phone bridge, for example wss://bridge.example.com.
PHONE_BRIDGE_PUBLIC_URL=
# Optional server-to-server HTTP(S) origin for provisioning sessions locally or privately.
# Example: http://localhost:8080. Exotel still uses PHONE_BRIDGE_PUBLIC_URL.
PHONE_BRIDGE_INTERNAL_URL=
# Shared secret between VoxFlow and the bridge; generate with `openssl rand -base64 32`.
PHONE_BRIDGE_SECRET=
# Optional bridge settings.
VOXFLOW_APP_URL=http://localhost:4321
# ElevenLabs credentials are supplied per authenticated user for each call and are never configured here.
ELEVENLABS_AUDIO_SAMPLE_RATE=16000
